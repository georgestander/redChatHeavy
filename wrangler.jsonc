{
  "main": "./src/worker.tsx",
  "compatibility_date": "2026-01-31",
  "compatibility_flags": [
    "nodejs_compat",
    "no_handle_cross_request_promise_resolution"
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "22222222222222222222222222222222",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/chatjs"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV_CACHE",
      "id": "00000000000000000000000000000000"
    },
    {
      "binding": "KV_RATE_LIMIT",
      "id": "11111111111111111111111111111111"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_ATTACHMENTS",
      "bucket_name": "placeholder-r2-attachments"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "STREAM_BUFFER_DO",
        "class_name": "StreamBufferDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["StreamBufferDO"]
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
